{
  "name": "atom-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tableau de bord ATOM-AI (atom.zelqane.com) : front Vite + React + three.js servi par un Worker Cloudflare.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "worker:dev": "wrangler dev",
    "contract:check": "node dev/contract-check.mjs",
    "contract:negative": "node contract/tools/test-negative.mjs",
    "geo:test": "node --experimental-strip-types --test tools/geo/tunisia.test.mjs",
    "contract:types": "node dev/gen-contract-types.mjs"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.19.21",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "5.2.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "wrangler": "4.144.0"
  }
}
